# Copy this file to `.env`. Never commit the populated `.env` file.
#
# URL printed by `modal deploy modal_app.py` for ReconViaGen.generate.
MODAL_ENDPOINT_URL=https://your-workspace--reconviagen-v05-reconviagen-generate.modal.run

# These protect calls to the deployed web endpoint. Create them with:
# modal workspace proxy-tokens create --json
# They are not MODAL_TOKEN_ID / MODAL_TOKEN_SECRET. Modal CLI account credentials
# are configured by `modal setup` and must not be copied into this project.
MODAL_PROXY_TOKEN_ID=wk-example
MODAL_PROXY_TOKEN_SECRET=ws-example

# Optional local server overrides.
RECONVIAGEN_REQUEST_TIMEOUT_SECONDS=3600
